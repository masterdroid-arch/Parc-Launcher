<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- T98: locked folders ask for the screen lock or a biometric through the framework BiometricPrompt. Normal permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- T100: the Agenda page reads upcoming events. Dangerous (runtime) permission, requested from a button, read only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!--
      T101: the Timers page rings a countdown with AlarmManager.setAlarmClock. USE_EXACT_ALARM is granted
      automatically at install to timer and alarm apps targeting API 33+, so there is no user flow and no
      SCHEDULE_EXACT_ALARM. POST_NOTIFICATIONS is the Android 13 runtime permission, requested the first
      time a timer starts; timers still work in the app without it.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      T257: reading aloud keeps the system text-to-speech voice running with the screen off. The
      service is a normal media-playback foreground service with its own quiet media notification;
      it adds no access to the microphone or the network.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      T187: the Steps page reads the phone's own step counter (Sensor.TYPE_STEP_COUNTER), which Android 10 and
      later only deliver to an app that holds this runtime permission ("Physical activity"). It is asked only when
      the user opens the Steps page and taps Allow. Nothing leaves the phone, and the page works without it
      (it says so). The step counter is not required: a phone without one just gets an explaining line.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!--
      T266: WorkManager is the card's weekly scheduler. Its library manifest normally adds WAKE_LOCK,
      ACCESS_NETWORK_STATE and RECEIVE_BOOT_COMPLETED; the job is a normal JobScheduler job with
      charging and idle constraints, so none of those extra permissions is needed. The app re-arms
      the unique weekly job on every start. Removing them keeps the manifest permission list exactly
      as it was before this card.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- T256: Define asks the installed dictionary apps that handle selected text. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
    <!--
      Back handling stays on androidx OnBackPressedCallback, the backward-compatible path.
      Left unset, Android 16 with targetSdk 36 enables predictive back by default and stops
      calling onBackPressed; this opt-out keeps the same handler from Android 13 up, and
      OnBackPressedCallback still runs when the flag is false (platform documentation).
    -->
    <application android:name=".ParcApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:theme="@style/Theme.Parc" android:allowBackup="false" android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false">
        <meta-data android:name="com.brightblu.parc.fileSearchEnabled" android:value="${fileSearchEnabled}" />
        <meta-data android:name="com.brightblu.parc.contactSearchEnabled" android:value="${contactSearchEnabled}" />
        <meta-data android:name="com.brightblu.parc.personalBuild" android:value="${personalBuild}" />
        <!-- T101: delivers a finished timer (and the notification's Dismiss action); not callable by other apps. -->
        <receiver android:name=".TimerReceiver" android:exported="false" />
        <!-- T257: the read-aloud media session and its play/pause notification. Not callable by other apps. -->
        <service android:name=".reader.ReaderTtsService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- OPUS6 (audit F8): re-checks the Focus Do Not Disturb rule at the scheduled change and after a
             clock or time-zone change. These two system broadcasts need no permission. -->
        <receiver android:name=".FocusDndReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity android:name=".PinItemActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".RecoveryActivity" android:exported="false" android:screenOrientation="portrait" />
        <!-- T207: the full-screen reader. No task affinity of its own: it opens over the launcher and
             back returns to the Library. T209 makes it the open-with target for EPUB, PDF and plain
             text; opening this way never adds the file to the library (the bar offers that action). -->
        <activity android:name=".reader.ReaderActivity" android:exported="true" android:taskAffinity=""
            android:screenOrientation="user" android:excludeFromRecents="true"
            android:launchMode="singleTop" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.Parc.Reader" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".SafeModeActivity" android:exported="false"
            android:process=":safe" android:taskAffinity="${applicationId}.safe" android:launchMode="singleTask" android:screenOrientation="portrait" />
        <!-- T250: shared text can start a new note beside the existing Commonplace quote share. -->
        <activity android:name=".ShareNoteActivity" android:exported="true"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="New note">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T191: opens a draft; only an explicit Save stores shared text. -->
            <intent-filter android:label="Commonplace">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
