<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      T137: the weather variant only. The Weather hub page asks Open-Meteo (https) for a forecast
      at the coordinates of the city the user typed. The personal and play builds never get this
      permission; the build's manifest check fails if either one does.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- T205: offered only by Find books. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- T293: lets the data-pack downloader tell Wi-Fi from mobile data for its Wi-Fi only switch. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- T293: hand the downloaded APK to the system installer (the user still taps Install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- T293: shares the downloaded APK with the installer. Never exported; grants are per-file. -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
